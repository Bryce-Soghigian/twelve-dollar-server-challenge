FROM twelve-go-uring
RUN apt-get update && apt-get install -y --no-install-recommends linux-tools-generic libsqlite3-0-dbgsym 2>/dev/null || apt-get install -y --no-install-recommends linux-tools-generic && rm -rf /var/lib/apt/lists/*
RUN ln -sf "$(ls -d /usr/lib/linux-tools/*/perf | head -1)" /usr/local/bin/perf
